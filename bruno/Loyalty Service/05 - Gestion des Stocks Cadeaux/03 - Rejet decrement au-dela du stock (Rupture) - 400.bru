meta {
  name: 03 - Rejet decrement au-dela du stock (Rupture) - 400
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/v1/loyalty/stores/{{storeId}}/gifts/{{giftId}}/stock
  body: json
  auth: bearer
}

auth:bearer {
  token: {{merchantToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "delta": -99999
  }
}

assert {
  res.status: eq 400
}

