meta {
  name: 03 - Creer un cadeau (ADMIN) - 201
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/loyalty/stores/{{storeId}}/gifts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Parapluie Ville de Lille",
    "description": "Parapluie coupe-vent offert par la ville et le commerce",
    "pointsCost": 150,
    "stock": 10,
    "imageUrl": "https://cdn.shoploc.fr/gifts/parapluie.png"
  }
}

assert {
  res.status: eq 201
  res.body.pointsCost: eq 150
  res.body.id: isDefined
}

