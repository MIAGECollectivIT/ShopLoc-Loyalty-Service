meta {
  name: 06 - Rejet configuration avec nombre de points nul ou negatif - 400
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/v1/loyalty/merchants/{{storeId}}/rates
  body: json
  auth: bearer
}

auth:bearer {
  token: {{merchantToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "euroAmount": 5.00,
    "pointsReward": 0
  }
}

assert {
  res.status: eq 400
}

