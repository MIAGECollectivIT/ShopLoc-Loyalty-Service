meta {
  name: 12 - Rejet creation cadeau pointsCost nul ou negatif - 400
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/v1/loyalty/stores/{{storeId}}/gifts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{merchantToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Cadeau Points Invalides",
    "pointsCost": -10,
    "stock": 5
  }
}

assert {
  res.status: eq 400
}

