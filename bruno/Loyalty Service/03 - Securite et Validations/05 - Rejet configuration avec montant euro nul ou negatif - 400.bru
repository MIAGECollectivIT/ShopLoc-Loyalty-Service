meta {
  name: 05 - Rejet configuration avec montant euro nul ou negatif - 400
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/v1/loyalty/merchants/{{storeId}}/rates
  body: json
  auth: bearer
}

auth:bearer {
  token: {{merchantToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "euroAmount": 0.00,
    "pointsReward": 5
  }
}

assert {
  res.status: eq 400
}

