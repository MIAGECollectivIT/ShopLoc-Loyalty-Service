meta {
  name: 14 - Rejet modification cadeau par commercant non proprietaire - 403
  type: http
  seq: 14
}

put {
  url: {{baseUrl}}/v1/loyalty/stores/9999/gifts/1
  body: json
  auth: bearer
}

auth:bearer {
  token: {{merchantToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Modification Non Autorisée",
    "pointsCost": 60
  }
}

assert {
  res.status: eq 403
}

